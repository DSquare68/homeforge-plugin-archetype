<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>${groupId}</groupId>
    <artifactId>${artifactId}</artifactId>
    <version>${version}</version>
    <packaging>jar</packaging>

    <name>${pluginName}</name>
    <description>${pluginDescription}</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!--
            ================================================================
            PLUGIN CONFIGURATION - edit these two properties
            ================================================================
            plugin.path   : URL path served by HUB, e.g. /gym
                            Accessible at https://hub.local/gym
            plugin.schema : PostgreSQL schema for this plugin's tables,
                            e.g. gym_schema
            ================================================================
        -->
        <plugin.path>${pluginPath}</plugin.path>
        <plugin.schema>${pluginSchema}</plugin.schema>

        <!-- Keep in sync with the HUB host version -->
        <hub-plugin-api.version>1.0.0-SNAPSHOT</hub-plugin-api.version>
        <pf4j.version>3.12.0</pf4j.version>
        <vaadin.version>24.5.0</vaadin.version>
        <flyway.version>13.2.0</flyway.version>
        <!-- Provided by the HUB host; keep in sync with the host's versions -->
        <hikaricp.version>7.0.2</hikaricp.version>
        <postgresql.version>42.7.11</postgresql.version>
    </properties>

    <dependencies>
        <!--
            HUB Plugin API - the only compile-time dependency you need.
            Everything else (Spring, Vaadin, PF4J, PostgreSQL driver) is
            provided by the HUB host at runtime; keep them [provided] so
            they are NOT bundled into the plugin jar.
        -->
        <dependency>
            <groupId>com.github.dsquare68</groupId>
            <artifactId>homeforge-api</artifactId>
            <version>${hub-plugin-api.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- PF4J - provided by host -->
        <dependency>
            <groupId>org.pf4j</groupId>
            <artifactId>pf4j</artifactId>
            <version>${pf4j.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Vaadin - provided by host -->
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>vaadin-core</artifactId>
            <version>${vaadin.version}</version>
            <scope>provided</scope>
        </dependency>

        <!--
            PostgreSQL driver and HikariCP - provided by the host. The plugin
            opens its own pool from the credentials HUB writes into this jar
            (see PluginDb), so it needs these at compile time only.
        -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>${hikaricp.version}</version>
            <scope>provided</scope>
        </dependency>

        <!--
            Flyway - needed only at install time to run migrations.
            Include it in the jar so the plugin is self-contained.
        -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <version>${flyway.version}</version>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <version>${flyway.version}</version>
        </dependency>

        <!-- Tests -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>

            <!--
                maven-jar-plugin - writes the PF4J manifest entries and
                injects plugin.path / plugin.schema as MANIFEST attributes
                so HUB can read them without loading the plugin class.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <!-- PF4J required entries -->
                            <Plugin-Id>${project.artifactId}</Plugin-Id>
                            <Plugin-Version>${project.version}</Plugin-Version>
                            <Plugin-Class>${package}.PluginBootstrap</Plugin-Class>
                            <!-- HUB custom entries - read by PluginManager without instantiation -->
                            <Hub-Path>${plugin.path}</Hub-Path>
                            <Hub-Schema>${plugin.schema}</Hub-Schema>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>

            <!--
                maven-shade-plugin - bundles Flyway (and any other [compile]
                dependencies) into a fat jar while excluding provided libs.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <!--
                                Merge META-INF/services entries instead of letting
                                one jar's file overwrite another's. Flyway finds its
                                database support (e.g. PostgreSQL) through that
                                ServiceLoader file - without this, migrations fail
                                with "Unsupported Database".
                            -->
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
