<?xml version="1.0" encoding="UTF-8"?>
<archetype-descriptor xmlns="https://maven.apache.org/plugins/maven-archetype-plugin/archetype-descriptor/1.1.0"
                       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                       xsi:schemaLocation="https://maven.apache.org/plugins/maven-archetype-plugin/archetype-descriptor/1.1.0 https://maven.apache.org/xsd/archetype-descriptor-1.1.0.xsd"
                       name="homeforge-plugin">

    <requiredProperties>
        <!-- URL path served by HUB for this plugin, e.g. /gym -> https://hub.local/gym -->
        <requiredProperty key="pluginPath">
            <defaultValue>/my-plugin</defaultValue>
        </requiredProperty>

        <!-- PostgreSQL schema dedicated to this plugin's tables -->
        <requiredProperty key="pluginSchema">
            <defaultValue>my_plugin_schema</defaultValue>
        </requiredProperty>

        <!-- Stable snake_case identifier, also used as the Flyway schema-history table prefix -->
        <requiredProperty key="pluginId">
            <defaultValue>my_plugin</defaultValue>
        </requiredProperty>

        <!-- Human readable name shown in the sidebar and plugin manager -->
        <requiredProperty key="pluginName">
            <defaultValue>My Plugin</defaultValue>
        </requiredProperty>
    </requiredProperties>

    <fileSets>
        <fileSet filtered="true" packaged="true" encoding="UTF-8">
            <directory>src/main/java</directory>
            <includes>
                <include>**/*.java</include>
            </includes>
        </fileSet>

        <fileSet filtered="true" packaged="false" encoding="UTF-8">
            <directory>src/main/resources</directory>
            <includes>
                <include>**/*.sql</include>
                <include>**/*.idx</include>
            </includes>
        </fileSet>

        <fileSet filtered="true" packaged="false" encoding="UTF-8">
            <directory></directory>
            <includes>
                <include>README.md</include>
            </includes>
        </fileSet>
    </fileSets>

</archetype-descriptor>
